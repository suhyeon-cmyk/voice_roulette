# Supabase 설정 (https://supabase.com 프로젝트 대시보드에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# 서버측 전용 서비스 롤 키 (RLS 우회 및 관리자 작업 시 사용, 미입력 시 anon key 사용)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage 버킷 이름 (음성 메시지 오디오 파일 저장소)
SUPABASE_STORAGE_BUCKET=voice-messages

# 룰렛 세팅 기본 관리자 비밀번호 (미지정 시 1234)
NEXT_PUBLIC_DEFAULT_SETTINGS_PASSWORD=1234

# 마스터 관리자 (/admin) 접속 비밀번호 (미지정 시 admin1234)
ADMIN_PASSWORD=admin1234
